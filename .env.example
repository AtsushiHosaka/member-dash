# ============================================
# Environment Variables Template
# ============================================
# このファイルをコピーして .env として使用してください
# cp .env.example .env
#
# 各環境での設定：
#   - 開発環境: Neon PostgreSQL development branch
#   - 本番環境: Neon PostgreSQL production branch (Vercelで設定)
# ============================================

# Database (Neon PostgreSQL)
# Neonダッシュボードから接続文字列を取得してください
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# NextAuth
# 開発: http://localhost:3000
# 本番: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret
# ランダムな文字列を生成してください（例: openssl rand -base64 32）
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Admin Account (シード用)
ADMIN_USER_ID="admin_lit_mentor"
ADMIN_PASSWORD="change-this-password"

# Node Environment
NODE_ENV="development"

# Cloudinary (画像アップロード用)
# Cloudinaryダッシュボードから取得してください
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
