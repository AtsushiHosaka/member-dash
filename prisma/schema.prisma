// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id         String      @id @default(cuid())
  name       String
  userLinks  UserSchool[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model User {
  id               String         @id @default(cuid())
  userId           String         @unique  // ユーザーID（ログイン用）
  name             String
  password         String
  courses          String[]       // 複数コース対応（配列）
  avatar           String?        // Optional avatar image URL
  role             String         @default("member")  // "admin", "mentor", or "member"
  schoolLinks      UserSchool[]   // 複数校舎対応（リレーション）
  sessions         Session[]
  gachaTickets     Int            @default(0)  // ガチャ券の枚数
  totalStudyHours  Float          @default(0)  // 累計学習時間（時間単位）
  userBadges       UserBadge[]    // 獲得したバッジ
  mentorLinks      MentorMember[] @relation("MemberToMentors") // メンバーが持つメンター関係
  memberLinks      MentorMember[] @relation("MentorToMembers") // メンターが持つメンバー関係
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// メンターとメンバーの多対多関係
model MentorMember {
  id        String   @id @default(cuid())
  mentorId  String
  memberId  String
  mentor    User     @relation("MentorToMembers", fields: [mentorId], references: [id], onDelete: Cascade)
  member    User     @relation("MemberToMentors", fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([mentorId, memberId])
}

// ユーザーと校舎の中間テーブル
model UserSchool {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
}

model Session {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime     DateTime             @default(now())
  endTime       DateTime?
  description   String?              // 旧フィールド（互換性のため残す）
  duration      Int?                 // Duration in seconds, calculated when session ends
  isActive      Boolean              @default(true)

  // 新しいフィールド
  goal          String?              // 今日の目標
  achievement   Int?                 // 達成度（％）
  whatIDid      String?              // やったこと
  whatILearned  String?              // わかったこと、学んだこと
  whatIWantToDo String?              // 次にやりたいこと

  editHistory   SessionEditHistory[] // 編集履歴

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// セッション編集履歴
model SessionEditHistory {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  editedBy      String   // 編集したユーザーのID
  editedAt      DateTime @default(now())

  // 編集前の値
  oldStartTime     DateTime?
  oldEndTime       DateTime?
  oldDuration      Int?
  oldGoal          String?
  oldAchievement   Int?
  oldWhatIDid      String?
  oldWhatILearned  String?
  oldWhatIWantToDo String?

  // 編集後の値
  newStartTime     DateTime?
  newEndTime       DateTime?
  newDuration      Int?
  newGoal          String?
  newAchievement   Int?
  newWhatIDid      String?
  newWhatILearned  String?
  newWhatIWantToDo String?
}

// ガチャから出るバッジ（景品）
model Badge {
  id             String      @id @default(cuid())
  name           String      // バッジ名
  icon           String      // アイコン（絵文字または画像パス）
  isPublic       Boolean     @default(true) // 誰にでも表示されるか
  allowedUserIds String[]    @default([]) // 特定ユーザーのみの場合、許可されたユーザーIDリスト
  userBadges     UserBadge[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ユーザーが獲得したバッジ
model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  obtainedAt DateTime @default(now())
}

// 命名投票
model NamingPoll {
  id        String             @id @default(cuid())
  isActive  Boolean            @default(false) // 投票を表示するかどうか
  options   NamingPollOption[]
  votes     NamingPollVote[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// 命名投票の選択肢
model NamingPollOption {
  id        String           @id @default(cuid())
  pollId    String
  poll      NamingPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String           // 選択肢のテキスト
  votes     NamingPollVote[]
  createdAt DateTime         @default(now())
}

// 命名投票の投票記録
model NamingPollVote {
  id        String           @id @default(cuid())
  pollId    String
  poll      NamingPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    NamingPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  votedAt   DateTime         @default(now())

  @@unique([pollId, userId]) // 各ユーザーは1つの投票に1回のみ投票可能
}
